import D4CounterexampleProof.CartanHighestModes

/-! The subspace generated by negative Drinfeld currents on an original
highest vector, with stability proved from the current relations. -/

namespace FrenkelReshetikhin.OriginalFR.Drinfeld

noncomputable section

open scoped BigOperators

variable (g : SimpleLieType)

theorem central_negative_is_identity {d : ℕ} (V : Representation g d) (hV : TypeOne g V) :
    V (quotientMap g (c g false)) = 1 := by
  have h := RingQuot.mkAlgHom_rel QuantumCoefficient (Relation.central_inverse (g := g) false)
  change quotientMap g (c g false * c g true) = quotientMap g 1 at h
  have he := congrArg V h
  simpa only [map_mul, map_one, hV.1, mul_one] using he

theorem centralPower_is_identity {d : ℕ} (V : Representation g d) (hV : TypeOne g V) (n : ℤ) :
    V (quotientMap g (centralPower g n)) = 1 := by
  unfold centralPower
  rw [map_pow, map_pow]
  by_cases hn : 0 ≤ n
  · simp only [decide_eq_true hn, hV.1, one_pow]
  · simp only [decide_eq_false hn, central_negative_is_identity g V hV, one_pow]

def negativeWord {d : ℕ} (V : Representation g d) :
    List (RootIndex g × ℤ) → Module.End QuantumCoefficient (Fin d → QuantumCoefficient)
  | [] => 1
  | (i, n) :: xs => V (quotientMap g (x g false i n)) * negativeWord V xs

def negativeDescendants {d : ℕ} (V : Representation g d) (v : Fin d → QuantumCoefficient) :
    Submodule QuantumCoefficient (Fin d → QuantumCoefficient) :=
  Submodule.span QuantumCoefficient (Set.range fun xs => negativeWord g V xs v)

theorem negativeWord_mem {d : ℕ} (V : Representation g d) (v : Fin d → QuantumCoefficient)
    (xs : List (RootIndex g × ℤ)) : negativeWord g V xs v ∈ negativeDescendants g V v :=
  Submodule.subset_span ⟨xs, rfl⟩

theorem highest_mem_negativeDescendants {d : ℕ} (V : Representation g d) (v : Fin d → QuantumCoefficient) :
    v ∈ negativeDescendants g V v := by
  simpa only [negativeWord, Module.End.one_apply] using negativeWord_mem g V v []

theorem negative_current_preserves_descendants {d : ℕ} (V : Representation g d)
    (v w : Fin d → QuantumCoefficient) (hw : w ∈ negativeDescendants g V v)
    (i : RootIndex g) (n : ℤ) :
    V (quotientMap g (x g false i n)) w ∈ negativeDescendants g V v := by
  induction hw using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨xs, rfl⟩ := hw
    exact negativeWord_mem g V v ((i, n) :: xs)
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b ha hb ia ib => rw [map_add]; exact Submodule.add_mem _ ia ib
  | smul a b hb ib => rw [map_smul]; exact Submodule.smul_mem _ a ib

theorem cartan_negative_commutator {d : ℕ} (V : Representation g d) (hV : TypeOne g V)
    (i j : RootIndex g) (n m : ℤ) (hn : n ≠ 0) (w : Fin d → QuantumCoefficient) :
    V (quotientMap g (h g i n)) (V (quotientMap g (x g false j m)) w) =
      V (quotientMap g (x g false j m)) (V (quotientMap g (h g i n)) w) +
      (((sign false : QuantumCoefficient) * qInteger quantumQ (n * B g i j) /
        (n : QuantumCoefficient)) • V (quotientMap g (x g false j (n + m))) w) := by
  have hrel := RingQuot.mkAlgHom_rel QuantumCoefficient (Relation.h_x i j false n m hn)
  change quotientMap g (h g i n * x g false j m - x g false j m * h g i n) =
    quotientMap g ((((sign false : QuantumCoefficient) * qInteger quantumQ (n * B g i j) /
      (n : QuantumCoefficient))) • (centralPower g (-sign false * (n.natAbs : ℤ)) *
        x g false j (n + m))) at hrel
  have he := congrArg (fun a : QuantumAffine g => V a w) hrel
  simp only [map_sub, map_mul, map_smul, LinearMap.sub_apply, Module.End.mul_apply,
    LinearMap.smul_apply, centralPower_is_identity g V hV, Module.End.one_apply] at he
  exact (sub_eq_iff_eq_add).mp he |>.trans (add_comm _ _)

theorem cartan_preserves_descendants {d : ℕ} (V : Representation g d) (hV : TypeOne g V)
    (v : Fin d → QuantumCoefficient)
    (hline : ∀ i n, ∃ scalar : QuantumCoefficient, V (quotientMap g (h g i n)) v = scalar • v)
    (i : RootIndex g) (n : ℤ) (w : Fin d → QuantumCoefficient)
    (hw : w ∈ negativeDescendants g V v) :
    V (quotientMap g (h g i n)) w ∈ negativeDescendants g V v := by
  have hwords (xs : List (RootIndex g × ℤ)) :
      V (quotientMap g (h g i n)) (negativeWord g V xs v) ∈ negativeDescendants g V v := by
    induction xs with
    | nil =>
      obtain ⟨scalar, hs⟩ := hline i n
      simpa only [negativeWord, Module.End.one_apply, hs] using
        (negativeDescendants g V v).smul_mem scalar (highest_mem_negativeDescendants g V v)
    | cons head xs ih =>
      by_cases hn : n = 0
      · have hz := RingQuot.mkAlgHom_rel QuantumCoefficient (Relation.zero_h i)
        change quotientMap g (h g i 0) = quotientMap g 0 at hz
        rw [hn, hz, map_zero, map_zero, LinearMap.zero_apply]
        exact Submodule.zero_mem _
      · rw [negativeWord, Module.End.mul_apply, cartan_negative_commutator g V hV i head.1 n head.2 hn]
        apply Submodule.add_mem
        · exact negative_current_preserves_descendants g V v _ ih head.1 head.2
        · apply Submodule.smul_mem
          exact negative_current_preserves_descendants g V v _ (negativeWord_mem g V v xs) head.1 (n + head.2)
  induction hw using Submodule.span_induction with
  | mem w hw => obtain ⟨xs, rfl⟩ := hw; exact hwords xs
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b ha hb ia ib => rw [map_add]; exact Submodule.add_mem _ ia ib
  | smul a b hb ib => rw [map_smul]; exact Submodule.smul_mem _ a ib

theorem negativeWord_weight {d : ℕ} (V : Representation g d) (weight : Weight g)
    (v : Fin d → QuantumCoefficient) (hv : v ∈ weightSpace g V weight)
    (xs : List (RootIndex g × ℤ)) :
    negativeWord g V xs v ∈
      weightSpace g V (weight - (xs.map fun a => simpleRoot g a.1).sum) := by
  induction xs with
  | nil => simpa only [negativeWord, Module.End.one_apply, List.map_nil, List.sum_nil, sub_zero] using hv
  | cons head xs ih =>
    have hh := current_maps_weightSpace g V _ _ ih false head.1 head.2
    rw [negativeWord, Module.End.mul_apply]
    have he : weight - (xs.map fun a => simpleRoot g a.1).sum + sign false • simpleRoot g head.1 =
        weight - ((simpleRoot g head.1) + (xs.map fun a => simpleRoot g a.1).sum) := by
      simp only [sign, Bool.false_eq_true, if_false, neg_one_smul]
      abel
    rw [he] at hh
    exact hh

theorem toral_preserves_descendants {d : ℕ} (V : Representation g d)
    (weight : Weight g) (v : Fin d → QuantumCoefficient) (hv : v ∈ weightSpace g V weight)
    (i : RootIndex g) (p : Bool) (w : Fin d → QuantumCoefficient)
    (hw : w ∈ negativeDescendants g V v) :
    V (quotientMap g (k g i p)) w ∈ negativeDescendants g V v := by
  have hwords (xs : List (RootIndex g × ℤ)) :
      V (quotientMap g (k g i p)) (negativeWord g V xs v) ∈ negativeDescendants g V v := by
    have hwgt := negativeWord_weight g V weight v hv xs
    cases p with
    | false =>
      rw [inverse_toral_on_weightVector g V _ _ hwgt i]
      exact Submodule.smul_mem _ _ (negativeWord_mem g V v xs)
    | true =>
      rw [(mem_weightSpace_iff g V _ _).mp hwgt i]
      exact Submodule.smul_mem _ _ (negativeWord_mem g V v xs)
  induction hw using Submodule.span_induction with
  | mem w hw => obtain ⟨xs, rfl⟩ := hw; exact hwords xs
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b ha hb ia ib => rw [map_add]; exact Submodule.add_mem _ ia ib
  | smul a b hb ib => rw [map_smul]; exact Submodule.smul_mem _ a ib

def invariantSubalgebra {d : ℕ} (V : Representation g d)
    (W : Submodule QuantumCoefficient (Fin d → QuantumCoefficient)) :
    Subalgebra QuantumCoefficient (QuantumAffine g) where
  carrier := {a | ∀ w ∈ W, V a w ∈ W}
  zero_mem' := by intro w hw; simp
  one_mem' := by intro w hw; simpa using hw
  add_mem' := by
    intro a b ha hb w hw
    simpa only [map_add, LinearMap.add_apply] using W.add_mem (ha w hw) (hb w hw)
  mul_mem' := by
    intro a b ha hb w hw
    simpa only [map_mul, Module.End.mul_apply] using ha _ (hb w hw)
  algebraMap_mem' := by
    intro scalar w hw
    rw [AlgHom.commutes]
    exact W.smul_mem scalar hw

theorem phi_preserves_descendants {d : ℕ} (V : Representation g d) (hV : TypeOne g V)
    (weight : Weight g) (v : Fin d → QuantumCoefficient) (hv : v ∈ weightSpace g V weight)
    (hline : ∀ i n, ∃ scalar : QuantumCoefficient, V (quotientMap g (h g i n)) v = scalar • v)
    (i : RootIndex g) (p : Bool) (n : ℤ) (w : Fin d → QuantumCoefficient)
    (hw : w ∈ negativeDescendants g V v) :
    V (quotientMap g (phi g p i n)) w ∈ negativeDescendants g V v := by
  let S := (invariantSubalgebra g V (negativeDescendants g V v)).comap (quotientMap g)
  have hk : k g i p ∈ S := toral_preserves_descendants g V weight v hv i p
  have hh (j : RootIndex g) (m : ℤ) : h g j m ∈ S := cartan_preserves_descendants g V hV v hline j m
  have hexp (m : ℕ) : cartanExponentialCoefficient g p i m ∈ S := by
    let L : PowerSeries (Free g) := PowerSeries.mk fun l => if l = 0 then 0 else
      ((sign p : QuantumCoefficient) * (quantumQ - quantumQ⁻¹)) • h g i (sign p * (l : ℤ))
    have hL (l : ℕ) (_ : l < m + 1) : PowerSeries.coeff l L ∈ S := by
      dsimp only [L]
      rw [PowerSeries.coeff_mk]
      split_ifs
      · exact S.zero_mem
      · exact S.smul_mem (hh i _) _
    change (∑ r ∈ Finset.range (m + 1), (r.factorial : QuantumCoefficient)⁻¹ •
      PowerSeries.coeff m (L ^ r)) ∈ S
    apply S.sum_mem
    intro r hr
    exact S.smul_mem (coeff_pow_mem_subalgebra_below S L (m + 1) hL r m (by omega)) _
  have hp : phi g p i n ∈ S := by
    unfold phi
    split_ifs
    · exact S.mul_mem hk (hexp n.natAbs)
    · exact S.zero_mem
  exact hp w hw

theorem positive_current_preserves_descendants {d : ℕ} (V : Representation g d) (hV : TypeOne g V)
    (weight : Weight g) (v : Fin d → QuantumCoefficient) (hv : v ∈ weightSpace g V weight)
    (hline : ∀ i n, ∃ scalar : QuantumCoefficient, V (quotientMap g (h g i n)) v = scalar • v)
    (hhigh : ∀ i n, V (quotientMap g (x g true i n)) v = 0)
    (i : RootIndex g) (n : ℤ) (w : Fin d → QuantumCoefficient)
    (hw : w ∈ negativeDescendants g V v) :
    V (quotientMap g (x g true i n)) w ∈ negativeDescendants g V v := by
  let W := negativeDescendants g V v
  let S := invariantSubalgebra g V W
  have hc (m : ℤ) : quotientMap g (centralPower g m) ∈ S := by
    intro u hu
    rw [centralPower_is_identity g V hV, Module.End.one_apply]
    exact hu
  have hphi (p : Bool) (j : RootIndex g) (m : ℤ) : quotientMap g (phi g p j m) ∈ S :=
    phi_preserves_descendants g V hV weight v hv hline j p m
  have hwords (xs : List (RootIndex g × ℤ)) :
      V (quotientMap g (x g true i n)) (negativeWord g V xs v) ∈ W := by
    induction xs with
    | nil =>
      rw [negativeWord, Module.End.one_apply, hhigh i n]
      exact Submodule.zero_mem _
    | cons head xs ih =>
      have hrel := RingQuot.mkAlgHom_rel QuantumCoefficient
        (Relation.opposite_sign i head.1 n head.2)
      change quotientMap g _ = quotientMap g _ at hrel
      have hcomm : quotientMap g (x g true i n * x g false head.1 head.2 -
          x g false head.1 head.2 * x g true i n) ∈ S := by
        rw [hrel]
        by_cases heq : i = head.1
        · rw [if_pos heq, map_smul, map_sub, map_mul, map_mul]
          exact S.smul_mem (S.sub_mem (S.mul_mem (hc _) (hphi true i _))
            (S.mul_mem (hc _) (hphi false i _))) _
        · rw [if_neg heq, map_zero]
          exact S.zero_mem
      have hm := hcomm _ (negativeWord_mem g V v xs)
      change V (quotientMap g (x g true i n * x g false head.1 head.2 -
        x g false head.1 head.2 * x g true i n)) (negativeWord g V xs v) ∈ W at hm
      simp only [map_sub, map_mul, LinearMap.sub_apply, Module.End.mul_apply] at hm
      have hadd := W.add_mem hm (negative_current_preserves_descendants g V v _ ih head.1 head.2)
      simpa only [sub_add_cancel, negativeWord, Module.End.mul_apply] using hadd
  induction hw using Submodule.span_induction with
  | mem w hw => obtain ⟨xs, rfl⟩ := hw; exact hwords xs
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b ha hb ia ib => rw [map_add]; exact Submodule.add_mem _ ia ib
  | smul a b hb ib => rw [map_smul]; exact Submodule.smul_mem _ a ib

/-- The triangular spanning result is proved for the original current
presentation: the cyclic highest vector generates using negative currents alone. -/
theorem negativeDescendants_eq_top {d : ℕ} (V : Representation g d) (hV : TypeOne g V)
    (weight : Weight g) (v : Fin d → QuantumCoefficient) (hv : v ∈ weightSpace g V weight)
    (hline : ∀ i n, ∃ scalar : QuantumCoefficient, V (quotientMap g (h g i n)) v = scalar • v)
    (hhigh : ∀ i n, V (quotientMap g (x g true i n)) v = 0)
    (hcyclic : ∀ w, ∃ a : QuantumAffine g, V a v = w) :
    negativeDescendants g V v = ⊤ := by
  let W := negativeDescendants g V v
  let S := invariantSubalgebra g V W
  let T := S.comap (quotientMap g)
  have hgen (a : Generator g) : FreeAlgebra.ι QuantumCoefficient a ∈ T := by
    cases a with
    | current p i n =>
      cases p with
      | false =>
        intro w hw
        exact negative_current_preserves_descendants g V v w hw i n
      | true => exact positive_current_preserves_descendants g V hV weight v hv hline hhigh i n
    | cartanMode i n => exact cartan_preserves_descendants g V hV v hline i n
    | toral i p => exact toral_preserves_descendants g V weight v hv i p
    | centralHalf p =>
      intro w hw
      change V (quotientMap g (c g p)) w ∈ W
      cases p with
      | false => rw [central_negative_is_identity g V hV, Module.End.one_apply]; exact hw
      | true => rw [hV.1, Module.End.one_apply]; exact hw
  have hall (a : Free g) : a ∈ T := by
    induction a using FreeAlgebra.induction with
    | grade0 r => exact T.algebraMap_mem r
    | grade1 a => exact hgen a
    | mul a b ha hb => exact T.mul_mem ha hb
    | add a b ha hb => exact T.add_mem ha hb
  apply top_unique
  intro w hw
  obtain ⟨a, rfl⟩ := hcyclic w
  obtain ⟨b, rfl⟩ := RingQuot.mkAlgHom_surjective QuantumCoefficient (Relation g) a
  exact hall b v (highest_mem_negativeDescendants g V v)

theorem fundamental_negative_spanning {d : ℕ} (i : RootIndex g)
    (V : Representation g d) (hV : FundamentalRepresentation g i V) :
    ∃ v : Fin d → QuantumCoefficient, v ≠ 0 ∧
      v ∈ weightSpace g V (fundamentalWeight g i) ∧ negativeDescendants g V v = ⊤ := by
  obtain ⟨a, ha, hP⟩ := hV.2.2
  obtain ⟨hconstant, v, eigenvalues, hv, hcyclic, hpositive, hphi, hratio⟩ := hP
  have htoral (j : RootIndex g) : V (quotientMap g (k g j true)) v =
      (quantumQ ^ rootLength g j) ^ (fundamentalPolynomials g i a j).natDegree • v := by
    have h0 := congrArg PowerSeries.constantCoeff (hratio true j)
    simp [shiftedPolynomial_coeff_zero, hconstant j] at h0
    simpa only [Nat.cast_zero, mul_zero, phi_zero, h0] using hphi true j 0
  have hweight : v ∈ weightSpace g V (fundamentalWeight g i) := by
    rw [weightSpace, Submodule.mem_iInf]
    intro j
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply,
      LinearMap.id_apply, htoral, fundamentalPolynomials_natDegree g i j a ha]
    by_cases hji : j = i
    · simp [hji, fundamentalWeight]
    · simp [hji, fundamentalWeight]
  refine ⟨v, hv, hweight, ?_⟩
  exact negativeDescendants_eq_top g V hV.1 (fundamentalWeight g i) v hweight
    (highest_cartan_modes_preserve_line g V v eigenvalues hphi) hpositive hcyclic

/-- Every nonzero ordinary weight lies below the defining Drinfeld
highest weight in the positive simple-root cone. -/
theorem fundamental_weight_below_highest {d : ℕ} (i : RootIndex g)
    (V : Representation g d) (hV : FundamentalRepresentation g i V)
    (weight : Weight g) (hweight : weightMultiplicity g V weight ≠ 0) :
    ∃ xs : List (RootIndex g), weight = fundamentalWeight g i - (xs.map (simpleRoot g)).sum := by
  classical
  obtain ⟨v, hv, hvweight, hspan⟩ := fundamental_negative_spanning g i V hV
  let allowed : Set (Weight g) := {w | ∃ xs : List (RootIndex g),
    w = fundamentalWeight g i - (xs.map (simpleRoot g)).sum}
  have hle : negativeDescendants g V v ≤ ⨆ w ∈ allowed, weightSpace g V w := by
    apply Submodule.span_le.mpr
    rintro w ⟨xs, rfl⟩
    apply Submodule.mem_iSup_of_mem (fundamentalWeight g i - (xs.map fun a => simpleRoot g a.1).sum)
    apply Submodule.mem_iSup_of_mem (show ∃ ys : List (RootIndex g),
        fundamentalWeight g i - (xs.map fun a => simpleRoot g a.1).sum =
          fundamentalWeight g i - (ys.map (simpleRoot g)).sum from ⟨xs.map Prod.fst, by simp [Function.comp_def]⟩)
    exact negativeWord_weight g V _ v hvweight xs
  by_contra hnot
  have hd := (independent_weightSpaces g V).disjoint_biSup (show weight ∉ allowed from hnot)
  have hpos : 0 < Module.finrank QuantumCoefficient (weightSpace g V weight) := Nat.pos_of_ne_zero hweight
  obtain ⟨w, hw⟩ := Module.finrank_pos_iff_exists_ne_zero.mp hpos
  have hwspan : w.val ∈ negativeDescendants g V v := by rw [hspan]; trivial
  have hz := Submodule.disjoint_def.mp hd w.val w.property (hle hwspan)
  exact hw (Subtype.ext hz)

end
end FrenkelReshetikhin.OriginalFR.Drinfeld
